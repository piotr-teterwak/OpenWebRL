# Copy to site.env and fill in your own beaker budget / workspace / clusters.
# launch_train.sh and launch_eval.sh source site.env if it exists.
# Keep the ${VAR:-...} form so values passed on the command line still win.
BUDGET=${BUDGET:-<org>/<budget>}
WORKSPACE=${WORKSPACE:-<org>/<workspace>}
CLUSTER=${CLUSTER:-<org>/<cluster>}
CLUSTER2=${CLUSTER2:-}
CLUSTER3=${CLUSTER3:-}
CLUSTER4=${CLUSTER4:-}
